{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "track2d cotracker3",
            "type": "debugpy",
            "request": "launch",
            "module": "track_4dgs.track2d",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--tracker",
                "cotracker3",
                "-s",
                "data/taekwondo/frame10",
                "data/taekwondo/frame20",
                "data/taekwondo/frame30",
                "data/taekwondo/frame40",
                "data/taekwondo/frame50",
                "-d",
                "output/taekwondo/frame1",
                "-i",
                "10000",
                "--num-points",
                "1024",
            ]
        },
        {
            "name": "track2d mvtap",
            "type": "debugpy",
            "request": "launch",
            "module": "track_4dgs.track2d",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--tracker",
                "mvtap",
                "-s",
                "data/taekwondo/frame10",
                "data/taekwondo/frame20",
                "data/taekwondo/frame30",
                "data/taekwondo/frame40",
                "data/taekwondo/frame50",
                "-d",
                "output/taekwondo/frame1",
                "-i",
                "10000",
                "--num-points",
                "1024",
                "--batch-size",
                "32",
            ]
        },
        {
            "name": "track2d blender",
            "type": "debugpy",
            "request": "launch",
            "module": "track_4dgs.track2d",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--tracker",
                "blender",
                "-s",
                "data/point_odyssey/robot/frame1",
                "data/point_odyssey/robot/frame2",
                "data/point_odyssey/robot/frame3",
                "data/point_odyssey/robot/frame4",
                "data/point_odyssey/robot/frame5",
                "-d",
                "output/point_odyssey_robot",
                "-i",
                "0",
                "--num-points",
                "1024",
                "-m",
                "blend='data/point_odyssey/data/demo_scene/robot.blend'",
                "-m",
                "blender='C:/Program Files (x86)/Steam/steamapps/common/Blender/blender.exe'",
                "-m",
                "start_number=1",
                "-m",
                "frame_step=3",
            ]
        },
        {
            "name": "track1v cotracker3",
            "type": "debugpy",
            "request": "launch",
            "module": "track_4dgs.track1v",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "args": [
                "--tracker",
                "cotracker3",
                "-s",
                "data/taekwondo/frame1/input/0.png",
                "data/taekwondo/frame10/input/0.png",
                "data/taekwondo/frame20/input/0.png",
                "data/taekwondo/frame30/input/0.png",
                "data/taekwondo/frame40/input/0.png",
                "data/taekwondo/frame50/input/0.png",
                "-d",
                "output/taekwondo/track1v-vggt-view0-time",
                "--num-points",
                "1024",
            ]
        }
    ]
